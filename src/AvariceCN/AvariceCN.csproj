<Project Sdk="Dalamud.CN.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Authors>Puni.sh</Authors>
    <Version>2.2.0.14</Version>
    <AssemblyName>AvariceCN</AssemblyName>
    <RootNamespace>Avarice</RootNamespace>
    <AssemblyTitle>Avarice 简中版</AssemblyTitle>
    <Description>Avarice 2.2.0.14 简体中文版本</Description>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>CS1591</NoWarn>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <EnableDefaultNoneItems>true</EnableDefaultNoneItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <OutputPath>..\..\artifacts\build\AvariceCN\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>..\..\artifacts\obj\AvariceCN\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PunishLib\PunishLib\PunishLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.0.1" />
    <PackageReference Include="ECommons" Version="3.2.1.15" />
    <PackageReference Include="Pictomancy" Version="1.0.10" />
  </ItemGroup>

  <ItemGroup>
    <None Update="res\AutoDetectTankRadius.csv">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="res\avarice_icon.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="LICENSE.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="..\..\plugins\AvariceCN\THIRD_PARTY_LICENSES.md" Link="THIRD_PARTY_LICENSES.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="..\..\LICENSE" Link="AGPL-3.0.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="DalamudPackager" Version="15.0.0" />
  </ItemGroup>
</Project>
